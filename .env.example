# Copy this file to .env and fill in your values
# ⚠️  Never commit .env to version control

# ── Demo mode ─────────────────────────────────────────────────────────────────
# When true, shows the demo PIN hint on the lock screen. Leave unset/false
# in any real deployment — never ship a visible unlock code in production.
VITE_DEMO_MODE=true

# ── Groq API (FREE — no credit card required) ────────────────────────────────
# Sign up at https://console.groq.com → API Keys → Create API Key
# Used for AI document scanning (vision model reads your uploaded images).
#
# ⚠️ NO "VITE_" PREFIX — this is intentional. VITE_-prefixed vars get bundled
# into the client-side JS and would be visible to anyone via devtools. This
# key is read only by the server-side function in api/scan.js, which proxies
# the Groq call so the key never reaches the browser. Set this in your
# hosting provider's environment variables (e.g. Vercel → Project Settings
# → Environment Variables) — for local dev with `vercel dev`, put it in .env
# without the VITE_ prefix and it'll be picked up by the serverless function.
GROQ_API_KEY=gsk_...

# ── Vision model (server-side, optional override) ───────────────────────────
# Current recommended Groq vision model (as of June 2026).
# Check https://console.groq.com/docs/models for the latest active model.
# GROQ_VISION_MODEL=qwen/qwen3.6-27b

# ── Supabase + Google sign-in (cross-device sync) ────────────────────────────
# Optional — the app works fully local-only without this. When set, users
# can sign in with Google and their AES-256-GCM ciphertext syncs across
# devices. Supabase NEVER sees the PIN or plaintext, only encrypted bytes.
#
# Setup: run supabase_schema.sql in your Supabase project's SQL editor,
# then enable the Google provider under Authentication → Providers.
# Project Settings → API → copy these two values:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
