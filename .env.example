# Copy this file to .env and fill in your values
# ⚠️  Never commit .env to version control

# ── Groq API (FREE — no credit card required) ────────────────────────────────
# Sign up at https://console.groq.com → API Keys → Create API Key
# Used for AI document scanning (vision model reads your uploaded images)
VITE_GROQ_API_KEY=gsk_...

# ── Vision model ──────────────────────────────────────────────────────────────
# Current recommended Groq vision model (as of June 2026).
# Check https://console.groq.com/docs/models for the latest active model.
# VITE_GROQ_VISION_MODEL=qwen/qwen3.6-27b

# ── Optional: Supabase for encrypted cross-device sync ───────────────────────
# The server only ever receives AES-256-GCM ciphertext — zero knowledge.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
